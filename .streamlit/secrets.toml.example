# これは見本です。値はすべてダミーです。
# 使い方：このファイルをコピーして「secrets.toml」という名前で同じフォルダに保存し、
#         本物の値に書き換えてください。secrets.toml は .gitignore により GitHub に上がりません。
# 公開環境では、同じ形式の内容を Streamlit Community Cloud の Secrets 画面に貼り付けます。

[spreadsheet]
id = "ここにスプレッドシートIDを貼り付け"
worksheet = "todos"

# サービスアカウントのJSONキーの中身を、下の形式に書き写します
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nxxxxxxxx\n-----END PRIVATE KEY-----\n"
client_email = "todo-app@your-project-id.iam.gserviceaccount.com"
client_id = "000000000000000000000"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/todo-app%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
